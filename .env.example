# Only these three are required. Everything else (brand, Stripe, Google sign-in, image generation)
# is configured by the admin in Admin → Settings and stored encrypted in the database.

# Public address of the site, no trailing slash. On Vercel this can be left out (the production domain is used).
APP_URL=http://localhost:3000

# 32+ random characters. Encrypts the admin settings and signs download links. NEVER change it after launch,
# or saved keys (Stripe, fal.ai, Google) can't be decrypted and must be re-entered.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Postgres connection string (Neon, Supabase, Railway…). Leave empty locally to use the built-in database in .data/.
DATABASE_URL=

# Optional: fixed first-run setup code instead of the one printed to the server log.
# SETUP_CODE=

# Optional recovery: emails that are always admins.
# ADMIN_EMAILS=
