# Public URL of the site (no trailing slash). Used for OAuth, Stripe redirects and MCP links.
APP_URL=http://localhost:3000
# 32+ random characters. Signs bundle download links. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Comma-separated emails that get the admin panel.
ADMIN_EMAILS=

# Postgres connection string (Neon, Supabase, etc). Leave empty locally to use the embedded PGlite database in .data/.
DATABASE_URL=

# Google sign-in (optional). Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (use sk_test_ keys until the live account is ready)
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard: <APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
